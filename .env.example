# Cloudflare account that owns the existing WAITLIST KV namespace.
# Dashboard → any Workers/Pages URL, or the account home. Not a secret.
CLOUDFLARE_ACCOUNT_ID=

# Existing KV namespace from wrangler.toml (binding WAITLIST).
# Same namespace the Cloudflare Pages Function wrote to — no email migration.
CLOUDFLARE_KV_NAMESPACE_ID=866652b0b0ff4c278c94f84d939c7f10

# API token with Account → Workers KV Storage → Edit on that account.
# Create at https://dash.cloudflare.com/profile/api-tokens — never commit the token.
CLOUDFLARE_API_TOKEN=

# Public webhook the old Pages Function called on brand-new signups.
# Same URL as wrangler.toml [vars]. WAITLIST_WEBHOOK_KEY.
WAITLIST_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/1c7b5e43-dcd2-5622-a649-cf1c0a486bd8

# Sender key (Cloudflare Pages secret WAITLIST_WEBHOOK_KEY). Never commit it.
WAITLIST_WEBHOOK_KEY=
